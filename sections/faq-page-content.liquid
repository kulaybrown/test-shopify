<!-- HERO SECTION -->
<section class="bg-gray-50 border-b border-gray-200 py-16 text-center">
  <div class="max-w-3xl mx-auto px-4">
    <span class="text-xs font-bold tracking-widest text-blue-600 uppercase bg-blue-50 px-3 py-1 rounded-full border border-blue-100">Help Center</span>
    <h1 class="text-4xl font-black uppercase tracking-tight text-gray-900 mt-4 mb-4">Frequently Asked Questions</h1>
    <p class="text-gray-600 text-base max-w-xl mx-auto leading-relaxed">
      Can't find what you're looking for? Reach out to our customer support team anytime at <span class="text-gray-900 font-semibold">support@{{ shop.domain }}</span>.
    </p>
  </div>
</section>

<!-- ACCORDION SECTION -->
<section class="max-w-3xl mx-auto px-4 py-16 lg:py-24">
  <div class="space-y-4">
    
    <!-- Item 1 -->
    <details class="group bg-white border border-gray-200 rounded-lg overflow-hidden shadow-xs" open>
      <summary class="flex items-center justify-between p-5 font-bold text-gray-900 cursor-pointer list-none select-none hover:bg-gray-50/70 transition">
        <span>How long will it take for my order to arrive?</span>
        <span class="text-xl text-gray-400 group-open:rotate-45 transition-transform duration-200 ease-out font-light">&plus;</span>
      </summary>
      <div class="p-5 pt-0 border-t border-gray-100 text-sm text-gray-600 leading-relaxed bg-gray-50/30">
        <p>Standard domestic shipments generally arrive within 3 to 5 business days from our fulfillment schedule.</p>
      </div>
    </details>

    <!-- Item 2 -->
    <details class="group bg-white border border-gray-200 rounded-lg overflow-hidden shadow-xs">
      <summary class="flex items-center justify-between p-5 font-bold text-gray-900 cursor-pointer list-none select-none hover:bg-gray-50/70 transition">
        <span>What is your return and exchange policy?</span>
        <span class="text-xl text-gray-400 group-open:rotate-45 transition-transform duration-200 ease-out font-light">&plus;</span>
      </summary>
      <div class="p-5 pt-0 border-t border-gray-100 text-sm text-gray-600 leading-relaxed bg-gray-50/30">
        <p>We offer full refunds or item exchanges within 30 days of shipment receipt. Items must be unworn and unwashed.</p>
      </div>
    </details>

  </div>
</section>

{% schema %}
{
  "name": "FAQ Page Layout",
  "settings": []
}
{% endschema %}