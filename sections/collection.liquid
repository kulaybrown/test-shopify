{% render 'collection-hero' %}

<!-- BREADCRUMB NAVIGATION -->
<nav class="bg-white border-b border-gray-200 py-3 mb-8" aria-label="Breadcrumb">
  <div id="ajax-breadcrumb" class="max-w-7xl mx-auto px-4 text-sm text-gray-500 flex items-center space-x-2">
    <a href="{{ routes.root_url }}" class="hover:text-blue-600 font-medium transition">Home</a>
    <span class="text-gray-400">/</span>
    <span class="text-gray-900 font-semibold truncate" aria-current="page">{{ collection.title }}</span>
  </div>
</nav>

{% paginate collection.products by 9 %}
<div id="ajax-collection-container" class="max-w-7xl mx-auto px-4 pb-16 transition-opacity duration-200">
  
  <!-- Collection Header Description Box -->
  <div class="mb-8">
    <h1 id="ajax-collection-title" class="text-3xl font-extrabold text-gray-900 tracking-tight mb-2">{{ collection.title }}</h1>
    <div id="ajax-collection-desc">
      {% if collection.description != blank %}
        <p class="text-base text-gray-600 max-w-3xl leading-relaxed">{{ collection.description }}</p>
      {% endif %}
    </div>
  </div>

  <!-- MAIN TWO-COLUMN LAYOUT -->
  <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 items-start">
    
    <!-- LEFT COLUMN: Dynamic Sidebar Menu Container -->
    <aside class="lg:col-span-1 bg-white p-6 border border-gray-200 rounded-lg shadow-sm lg:sticky lg:top-4">
      
      {%- assign current_handle = collection.handle | downcase -%}
      
      {%- comment -%} 
        STRICT EXACT MATCHING: 
        Only 'for-mens' and 'for-womens' get the AJAX Category Tree Navigation.
        Everything else defaults directly to the Filter panel.
      {%- endcomment -%}
      {%- if current_handle == 'for-mens' or current_handle == 'for-womens' -%}
        
        <h2 class="text-lg font-bold text-gray-900 mb-4 pb-2 border-b">Shop Categories</h2>
        <nav id="ajax-sidebar-menu" class="space-y-4">
          {%- for link in linklists.main-menu.links -%}
            {%- assign link_title_down = link.title | downcase -%}
            
            {%- if current_handle == 'for-mens' and link_title_down == 'for men' -%}
              {%- if link.links != blank -%}
                <ul class="space-y-2.5">
                  {%- for childlink in link.links -%}
                    <li>
                      <a href="{{ childlink.url }}" class="ajax-sidebar-link block text-sm font-medium {% if childlink.active or collection.url == childlink.url %}text-blue-600 font-semibold active-ajax-link{% else %}text-gray-700 hover:text-blue-600{% endif %} transition flex items-center justify-between">
                        <span>{{ childlink.title }}</span>
                        <span class="text-gray-400 text-xs">→</span>
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            {%- endif -%}

            {%- if current_handle == 'for-womens' and link_title_down == 'for women' -%}
              {%- if link.links != blank -%}
                <ul class="space-y-2.5">
                  {%- for childlink in link.links -%}
                    <li>
                      <a href="{{ childlink.url }}" class="ajax-sidebar-link block text-sm font-medium {% if childlink.active or collection.url == childlink.url %}text-blue-600 font-semibold active-ajax-link{% else %}text-gray-700 hover:text-blue-600{% endif %} transition flex items-center justify-between">
                        <span>{{ childlink.title }}</span>
                        <span class="text-gray-400 text-xs">→</span>
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            {%- endif -%}

          {%- endfor -%}
        </nav>

      {%- else -%}
        
        <h2 class="text-lg font-bold text-gray-900 mb-4 pb-2 border-b">Filters</h2>
        <form class="space-y-6">
          <div>
            <h3 class="text-sm font-semibold text-gray-800 uppercase tracking-wider mb-3">Availability</h3>
            <div class="space-y-2">
              <label class="flex items-center text-sm text-gray-600 cursor-pointer">
                <input type="checkbox" name="filter.v.availability" value="1" class="rounded border-gray-300 text-blue-600 focus:ring-blue-500 mr-2.5 h-4 w-4">
                In Stock ({{ collection.products_count }})
              </label>
            </div>
          </div>

          <div>
            <h3 class="text-sm font-semibold text-gray-800 uppercase tracking-wider mb-3">Price Range</h3>
            <div class="flex items-center space-x-2">
              <div class="relative flex-1">
                <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400 text-sm">$</span>
                <input type="number" name="filter.v.price.gte" placeholder="Min" min="0" class="w-full pl-7 pr-3 py-1.5 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-1 focus:ring-blue-500">
              </div>
              <span class="text-gray-400 text-sm">to</span>
              <div class="relative flex-1">
                <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400 text-sm">$</span>
                <input type="number" name="filter.v.price.lte" placeholder="Max" min="0" class="w-full pl-7 pr-3 py-1.5 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-1 focus:ring-blue-500">
              </div>
            </div>
          </div>

          <button type="submit" class="w-full py-2 bg-gray-900 text-white font-medium text-xs rounded-md shadow-xs hover:bg-gray-800 transition tracking-wider uppercase">
            Apply Filters
          </button>
        </form>

      {%- endif -%}

    </aside>

    <!-- RIGHT COLUMN: Product Grid Container -->
    <main class="lg:col-span-3">
      <div id="ajax-product-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        {% for product in collection.products %}
          <div class="group bg-white border border-gray-200 rounded-lg overflow-hidden shadow-xs hover:shadow-md transition duration-200">
            <a href="{{ product.url | within: collection }}" class="block">
              <div class="aspect-square bg-gray-100 flex items-center justify-center overflow-hidden">
                {% if product.featured_image != blank %}
                  <img src="{{ product.featured_image | image_url: width: 500 }}" alt="{{ product.title | escape }}" loading="lazy" class="w-full h-full object-cover group-hover:scale-102 transition duration-300" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}">
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'w-full h-full bg-gray-200' }}
                {% endif %}
              </div>
              <div class="p-4 text-center">
                <h3 class="text-sm font-semibold text-gray-800 group-hover:text-blue-600 transition truncate">{{ product.title }}</h3>
                <p class="text-sm text-gray-600 font-medium mt-1">{{ product.price | money }}</p>
              </div>
            </a>
          </div>
        {% else %}
          <div class="col-span-3 text-center py-20 bg-white border border-gray-200 rounded-lg">
            <p class="text-gray-500 font-medium">No products found in this collection.</p>
          </div>
        {% endfor %}
      </div>

      <!-- PAGINATION BAR -->
      <div id="ajax-pagination">
        {% if paginate.pages > 1 %}
          <div class="mt-12 flex justify-center items-center space-x-2 border-t border-gray-200 pt-6">
            {% if paginate.previous %}
              <a href="{{ paginate.previous.url }}" class="ajax-pagination-link px-4 py-2 bg-white border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50 transition">Previous</a>
            {% endif %}
            <span class="text-sm text-gray-500 font-medium px-4">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
            {% if paginate.next %}
              <a href="{{ paginate.next.url }}" class="ajax-pagination-link px-4 py-2 bg-white border border-gray-300 rounded-md text-sm font-medium text-gray-700 hover:bg-gray-50 transition">Next</a>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </main>

  </div>
</div>
{% endpaginate %}


<script>
  document.addEventListener('DOMContentLoaded', function() {
    const container = document.getElementById('ajax-collection-container');

    // Main AJAX function to fetch and swap collection content
    function loadCollectionPage(url) {
      // 1. Give the user a quick loading visual cue
      container.classList.add('opacity-40');

      fetch(url)
        .then(response => response.text())
        .then(html => {
          const parser = new DOMParser();
          const doc = parser.parseFromString(html, 'text/html');

          // 2. Hot-swap the essential data blocks
          document.getElementById('ajax-product-grid').innerHTML = doc.getElementById('ajax-product-grid').innerHTML;
          document.getElementById('ajax-pagination').innerHTML = doc.getElementById('ajax-pagination').innerHTML;
          document.getElementById('ajax-collection-title').innerText = doc.getElementById('ajax-collection-title').innerText;
          document.getElementById('ajax-collection-desc').innerHTML = doc.getElementById('ajax-collection-desc').innerHTML;
          document.getElementById('ajax-breadcrumb').innerHTML = doc.getElementById('ajax-breadcrumb').innerHTML;

          // 3. Keep the sidebar link highlighting updated perfectly
          const newSidebarMenu = doc.getElementById('ajax-sidebar-menu');
          if (newSidebarMenu) {
            document.getElementById('ajax-sidebar-menu').innerHTML = newSidebarMenu.innerHTML;
          }

          // 4. Update the browser URL bar so refreshing works normally
          history.pushState({ url: url }, '', url);

          // 5. Scroll smoothly up to the grid top so they can see new items
          window.scrollTo({ top: container.offsetTop - 40, behavior: 'smooth' });
        })
        .catch(error => console.error('Error fetching collection AJAX data:', error))
        .finally(() => {
          // 6. Fade the container back in smoothly
          container.classList.remove('opacity-40');
        });
    }

    // Capture clicks inside the container (Event Delegation handles re-rendered elements!)
    if (container) {
      container.addEventListener('click', function(e) {
        // Look for targeted sidebar links or pagination buttons
        const link = e.target.closest('.ajax-sidebar-link, .ajax-pagination-link');
        
        if (link) {
          e.preventDefault();
          const targetUrl = link.getAttribute('href');
          if (targetUrl && targetUrl !== '#') {
            loadCollectionPage(targetUrl);
          }
        }
      });
    }

    // Ensure browser back/forward buttons still work with our AJAX navigation
    window.addEventListener('popstate', function(e) {
      if (e.state && e.state.url) {
        loadCollectionPage(e.state.url);
      } else {
        window.location.reload();
      }
    });
  });
</script>