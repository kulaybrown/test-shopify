<footer class="site-footer bg-gray-900 text-gray-300 border-t border-gray-800 pt-16 pb-8 mt-auto">
  <div class="max-w-7xl mx-auto px-4">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 mb-12">
      
      <div class="space-y-4">
        <h3 class="text-white text-lg font-bold tracking-wider uppercase">
          {{ shop.name }}
        </h3>
        <p class="text-sm text-gray-400 leading-relaxed">
          {{ section.settings.footer_about_text | default: "Your premier destination for modern apparel and custom items." }}
        </p>
      </div>

      <div>
        <h4 class="text-white text-sm font-semibold uppercase tracking-wider mb-4">Quick Links</h4>
        <ul class="space-y-2.5 text-sm">
          {%- for link in linklists[section.settings.footer_menu_1].links -%}
            <li>
              <a href="{{ link.url }}" class="hover:text-white transition-colors duration-150">
                {{ link.title }}
              </a>
            </li>
          {%- else -%}
            {%- comment -%} Fallback if menu isn't selected yet {%- endcomment -%}
            <li><a href="/" class="hover:text-white">Home</a></li>
            <li><a href="/collections/all" class="hover:text-white">Shop All</a></li>
          {%- endfor -%}
        </ul>
      </div>

      <div>
        <h4 class="text-white text-sm font-semibold uppercase tracking-wider mb-4">Categories</h4>
        <ul class="space-y-2.5 text-sm">
          {%- for link in linklists.main-menu.links -%}
            {%- if link.title == "ALL" and link.links != blank -%}
              {%- for childlink in link.links -%}
                <li>
                  <a href="{{ childlink.url }}" class="hover:text-white transition-colors duration-150 capitalize">
                    {{ childlink.title }}
                  </a>
                </li>
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      <div>
        <h4 class="text-white text-sm font-semibold uppercase tracking-wider mb-4">Support</h4>
        <ul class="space-y-2.5 text-sm text-gray-400">
          
          {%- comment -%} 
            Looks up the live 'about' or 'about-us' page handle dynamically. 
            If your handle is 'about-us', change pages.about to pages['about-us']
          {%- endcomment -%}
          {%- if pages.about != blank or pages['about-us'] != blank -%}
            {%- assign about_page = pages.about | default: pages['about-us'] -%}
            <li>
              <a href="{{ about_page.url }}" class="hover:text-white transition-colors duration-150">
                {{ about_page.title }}
              </a>
            </li>
          {%- endif -%}

          {%- comment -%} 
            Looks up the live 'faq' or 'faqs' page handle dynamically.
          {%- endcomment -%}
          {%- if pages.faq != blank or pages.faqs != blank -%}
            {%- assign faq_page = pages.faq | default: pages.faqs -%}
            <li>
              <a href="{{ faq_page.url }}" class="hover:text-white transition-colors duration-150">
                {{ faq_page.title }}
              </a>
            </li>
          {%- endif -%}

          <li>
            <a href="/pages/contact" class="hover:text-white transition-colors duration-150">
              Contact Support
            </a>
          </li>
        </ul>
      </div>

      <div class="space-y-4">
        <h4 class="text-white text-sm font-semibold uppercase tracking-wider mb-4">Get In Touch</h4>
        <p class="text-sm text-gray-400">Have questions or need help with an order?</p>
        <div class="pt-2 text-sm text-gray-400 space-y-1">
          <p>Email: <span class="text-white">support@{{ shop.domain }}</span></p>
        </div>
      </div>

    </div>

    <div class="border-t border-gray-800 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-gray-500">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}. All rights reserved.</p>
      <div class="flex gap-6">
        <a href="#" class="hover:text-gray-400 transition">Privacy Policy</a>
        <a href="#" class="hover:text-gray-400 transition">Terms of Service</a>
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer Layout",
  "settings": [
    {
      "type": "textarea",
      "id": "footer_about_text",
      "label": "About Store Description",
      "default": "Your premier destination for modern apparel and custom items."
    },
    {
      "type": "link_list",
      "id": "footer_menu_1",
      "label": "Select Primary Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}