<div 
  id="cart-drawer-overlay" 
  class="fixed inset-0 bg-black/50 z-[200] invisible opacity-0 transition-opacity duration-300 backdrop-blur-xs"
  aria-hidden="true"
></div>

<div 
  id="cart-drawer" 
  class="fixed top-0 right-0 bottom-0 w-full max-w-md bg-white z-[210] shadow-2xl translate-x-full transition-transform duration-300 ease-in-out flex flex-col"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cart-drawer-title"
>
  <!-- Drawer Header -->
  <div class="p-4 border-b border-gray-200 flex items-center justify-between">
    <h2 id="cart-drawer-title" class="text-lg font-bold text-gray-900">Your Cart (<span id="drawer-cart-count">{{ cart.item_count }}</span>)</h2>
    <button 
      type="button" 
      id="close-cart-drawer" 
      class="p-2 text-gray-500 hover:text-gray-800 text-2xl line-none focus:outline-none"
      aria-label="Close cart"
    >
      &times;
    </button>
  </div>

  <!-- Drawer Body: Dynamic Line Items Container -->
  <div id="cart-drawer-items" class="flex-1 overflow-y-auto p-4 space-y-4">
    {% if cart.item_count > 0 %}
      {% for item in cart.items %}
        <div class="flex items-center gap-4 py-3 border-b border-gray-100 last:border-none">
          <div class="w-20 h-20 bg-gray-50 rounded-lg overflow-hidden border border-gray-200 flex-shrink-0">
            {% if item.image != blank %}
              <img src="{{ item.image | image_url: width: 150 }}" alt="{{ item.product.title | escape }}" class="w-full h-full object-cover">
            {% endif %}
          </div>
          <div class="flex-1 min-w-0">
            <h3 class="text-sm font-semibold text-gray-900 truncate">{{ item.product.title }}</h3>
            {% unless item.product.has_only_default_variant %}
              <p class="text-xs text-gray-500 mt-0.5">{{ item.variant.title }}</p>
            {% endunless %}
            <p class="text-sm text-gray-600 font-medium mt-1">{{ item.final_line_price | money }}</p>
            <p class="text-xs text-gray-400 mt-0.5">Qty: {{ item.quantity }}</p>
          </div>
        </div>
      {% endfor %}
    {% else %}
      <div class="text-center py-20 text-gray-500">
        <p class="font-medium">Your cart is empty.</p>
      </div>
    {% endif %}
  </div>

  <!-- Drawer Footer -->
  <div class="p-4 border-t border-gray-200 bg-gray-50 space-y-4">
    <div class="flex justify-between items-baseline">
      <span class="text-sm font-medium text-gray-600">Subtotal</span>
      <span id="drawer-cart-subtotal" class="text-lg font-black text-gray-900">{{ cart.total_price | money }}</span>
    </div>
    <p class="text-xs text-gray-500">Shipping and taxes calculated at checkout.</p>
    
    <form action="{{ routes.cart_url }}" method="post" class="space-y-2">
      <button 
        type="submit" 
        name="checkout" 
        class="w-full py-3 bg-gray-900 text-white text-sm font-bold uppercase tracking-wider rounded-md hover:bg-gray-800 transition"
        {% if cart.item_count == 0 %}disabled{% endif %}
      >
        Proceed To Checkout
      </button>
    </form>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const cartDrawer = document.getElementById('cart-drawer');
    const overlay = document.getElementById('cart-drawer-overlay');
    const openBtn = document.getElementById('cart-icon-bubble');
    const closeBtn = document.getElementById('close-cart-drawer');

    function openCartDrawer(e) {
      if (e) e.preventDefault(); // Stop redirection to /cart page
      cartDrawer.classList.remove('translate-x-full');
      overlay.classList.remove('invisible', 'opacity-0');
    }

    function closeCartDrawer() {
      cartDrawer.classList.add('translate-x-full');
      overlay.classList.add('invisible', 'opacity-0');
    }

    if (openBtn) openBtn.addEventListener('click', openCartDrawer);
    if (closeBtn) closeBtn.addEventListener('click', closeCartDrawer);
    if (overlay) overlay.addEventListener('click', closeCartDrawer);

    // OPTIONAL INTERCEPTOR: Opens drawer instantly when single product form is added
    const productForm = document.querySelector('form[action="/cart/add"]');
    if (productForm) {
      productForm.addEventListener('submit', function() {
        // A slight timeout allows the form data payload to register to Shopify's servers
        setTimeout(() => {
          // Force fetch clean layout data updates 
          fetch(window.location.pathname)
            .then(response => response.text())
            .then(html => {
              const parser = new DOMParser();
              const doc = parser.parseFromString(html, 'text/html');
              
              // Dynamic hot-swap replacement elements
              document.getElementById('cart-drawer-items').innerHTML = doc.getElementById('cart-drawer-items').innerHTML;
              document.getElementById('drawer-cart-count').innerText = doc.getElementById('drawer-cart-count').innerText;
              document.getElementById('drawer-cart-subtotal').innerText = doc.getElementById('drawer-cart-subtotal').innerText;
              
              openCartDrawer();
            });
        }, 600);
      });
    }
  });
</script>


{% schema %}
{
  "name": "Cart Drawer",
  "settings": []
}
{% endschema %}