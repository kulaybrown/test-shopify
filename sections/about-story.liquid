<section class="bg-gray-950 text-white py-16 lg:py-24 text-center relative overflow-hidden">
  <div class="absolute inset-0 opacity-10 pointer-events-none">
    <div class="absolute inset-0 bg-[radial-gradient(#ffffff_1px,transparent_1px)] [background-size:20px_20px]"></div>
  </div>
  <div class="max-w-3xl mx-auto px-4 relative z-10">
    <span class="text-xs font-bold tracking-widest text-blue-400 uppercase bg-blue-500/10 px-3 py-1 rounded-full border border-blue-500/20">Our Story</span>
    <h1 class="text-4xl sm:text-5xl font-black uppercase tracking-tight mt-4 mb-6">About {{ shop.name }}</h1>
    <p class="text-gray-400 text-base sm:text-lg max-w-xl mx-auto leading-relaxed">
      Crafting premium essentials with a commitment to quality, modern architecture, and timeless design.
    </p>
  </div>
</section>

<section class="max-w-7xl mx-auto px-4 py-16 lg:py-24">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
    
    <!-- Image Placeholder Panel -->
    <div class="relative group">
      <div class="absolute -inset-2 bg-gradient-to-r from-blue-600 to-indigo-600 rounded-2xl opacity-10 blur-xl"></div>
      <div class="relative aspect-video lg:aspect-square bg-gray-100 border border-gray-200 rounded-xl overflow-hidden flex items-center justify-center">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'w-full h-full text-gray-300 bg-gray-50 object-cover' }}
        <div class="absolute inset-0 bg-black/5 flex items-center justify-center">
          <span class="bg-white/90 backdrop-blur-xs text-xs font-bold text-gray-700 uppercase tracking-wider px-4 py-2 rounded-md shadow-xs border border-gray-200">
            Image Asset Placeholder
          </span>
        </div>
      </div>
    </div>

    <!-- Narrative Sample Text -->
    <div class="space-y-6">
      <div class="space-y-2">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">Who We Are</h2>
        <div class="w-12 h-1 bg-blue-600 rounded"></div>
      </div>
      <div class="prose text-gray-600 space-y-4 leading-relaxed">
        <p class="font-medium text-gray-900 text-base">
          Founded with a clear vision to redefine daily essentials, {{ shop.name }} blends functional minimalism with superior craftsmanship. 
        </p>
        <p>
          We believe that every product should tell a story of careful consideration and premium execution. From selecting the base structural components to refining the final finish details, our collection matrix is engineered to match your modern lifestyle requirements seamlessly.
        </p>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "About Story Content",
  "settings": []
}
{% endschema %}