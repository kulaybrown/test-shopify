<div class="py-12">
  <div class="max-w-7xl mx-auto px-4 grid grid-cols-1 lg:grid-cols-4 gap-8">
    
    <aside class="lg:col-span-1 bg-white p-6 border border-gray-200 rounded-lg shadow-sm h-fit">
      <h2 class="text-xl font-bold text-gray-900 mb-6 border-b pb-3">Shop By Item</h2>
      
      <nav class="space-y-2" id="sidebar-nav">
        {%- for link in linklists.main-menu.links -%}
          {%- assign parent_title_down = link.title | downcase -%}
          
          {%- comment -%} Target ONLY the "ALL" parent menu branch {%- endcomment -%}
          {%- if parent_title_down == 'all' and link.links != blank -%}
            {%- for childlink in link.links -%}
              {%- comment -%} Pull the actual collection handle from the link URL {%- endcomment -%}
              {%- assign collection_handle = childlink.url | split: '/collections/' | last -%}
              
              <button 
                type="button"
                data-collection-url="{{ childlink.url }}"
                data-collection-handle="{{ collection_handle }}"
                class="sidebar-tab-btn w-full text-left px-4 py-2.5 rounded-md text-sm font-medium transition flex items-center justify-between {% if forloop.first %}bg-blue-50 text-blue-700 active-tab{% else %}text-gray-700 hover:bg-gray-100{% endif %}"
              >
                <span>{{ childlink.title }}</span>
                <span class="text-gray-400 text-xs">→</span>
              </button>
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
      </nav>
    </aside>

    <main class="lg:col-span-3">
      
      <div id="dynamic-product-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        {%- comment -%} 
          Initial Load: We grab the very first child collection from the loop above 
          to display products immediately when the homepage loads.
        {%- endcomment -%}
        {%- assign first_parent = linklists.main-menu.links | where: "title", "ALL" | first -%}
        {%- assign initial_collection = first_parent.links.first.url | split: '/collections/' | last | strip -%}
        
        {%- if collections[initial_collection] != blank -%}
          {% for product in collections[initial_collection].products limit: 9 %}
            <div class="bg-white border border-gray-200 rounded-lg overflow-hidden shadow-sm">
              <a href="{{ product.url }}" class="block">
                <div class="aspect-square bg-gray-100 flex items-center justify-center overflow-hidden">
                  {% if product.featured_image != blank %}
                    <img 
                      src="{{ product.featured_image | image_url: width: 400 }}" 
                      alt="{{ product.title | escape }}" 
                      loading="lazy"
                      class="w-full h-full object-cover"
                      width="{{ product.featured_image.width }}"
                      height="{{ product.featured_image.height }}"
                    >
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'w-full h-full bg-gray-200' }}
                  {% endif %}
                </div>
                <div class="p-4 text-center">
                  <h3 class="text-sm font-bold text-gray-800 truncate">{{ product.title }}</h3>
                  <p class="text-sm text-gray-600 font-medium mt-1">{{ product.price | money }}</p>
                </div>
              </a>
            </div>
          {% endfor %}
        {%- endif -%}
      </div>

      <div class="mt-12 flex justify-center border-t border-gray-200 pt-6">
        <a 
          id="view-all-btn" 
          href="{{ first_parent.links.first.url }}" 
          class="inline-block px-6 py-3 bg-gray-900 text-white font-medium text-sm rounded-md shadow-sm hover:bg-gray-800 transition"
        >
          View All {{ first_parent.links.first.title }}
        </a>
      </div>

    </main>
  </div>
</div>

{%- comment -%} 
  AJAX Client-side Interceptor Engine: 
  Listens to clicks on your sidebar sub-items and swaps out contents instantly.
{%- endcomment -%}
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const tabButtons = document.querySelectorAll('.sidebar-tab-btn');
    const gridContainer = document.getElementById('dynamic-product-grid');
    const viewAllBtn = document.getElementById('view-all-btn');

    tabButtons.forEach(button => {
      button.addEventListener('click', async function() {
        // 1. UI Tab Highlighting States
        tabButtons.forEach(btn => btn.classList.remove('bg-blue-50', 'text-blue-700', 'active-tab'));
        tabButtons.forEach(btn => btn.classList.add('text-gray-700', 'hover:bg-gray-100'));
        this.classList.add('bg-blue-50', 'text-blue-700', 'active-tab');
        this.classList.remove('text-gray-700', 'hover:bg-gray-100');

        const collectionUrl = this.getAttribute('data-collection-url');
        const collectionHandle = this.getAttribute('data-collection-handle');
        const tabTitle = this.querySelector('span').innerText;

        // 2. Visual Loading State Shimmer
        gridContainer.style.opacity = '0.4';

        try {
          // 3. Request Shopify to deliver just the raw collection layout data via section rendering API
          const response = await fetch(`${collectionUrl}?view=ajax`);
          if (!response.ok) throw new Error('Network error');
          
          const rawHtml = await response.text();
          
          // Parse HTML and update container grid
          const parser = new DOMParser();
          const doc = parser.parseFromString(rawHtml, 'text/html');
          const incomingGrid = doc.getElementById('dynamic-product-grid');

          if(incomingGrid) {
            gridContainer.innerHTML = incomingGrid.innerHTML;
          } else {
             gridContainer.innerHTML = `<p class="col-span-3 text-center py-12 text-gray-500">No products found in this category.</p>`;
          }
          
          // 4. Transform Destination Action Target Link
          viewAllBtn.setAttribute('href', collectionUrl);
          viewAllBtn.innerText = `View All ${tabTitle}`;
          
        } catch (error) {
          console.error("Failed loading target grid items:", error);
        } finally {
          gridContainer.style.opacity = '1';
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Sidebar + Ajax Grid",
  "settings": [],
  "presets": [
    {
      "name": "Sidebar + Ajax Grid"
    }
  ]
}
{% endschema %}